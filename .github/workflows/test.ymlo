name: test project 
on: [push, workflow_dispatch]
env:
  MONGO_PASSWORD: ${{secrets.MONGO_PASSWORD}}
  MONGO_HOST: 'cluster0.tp7f9sn.mongodb.net'
  MONGO_USER: ${{secrets.MONGO_USER}}
  MONGO_DB:  'DEMO'

jobs:
  test:
    uses: ./.github/workflows/reusable.yml
    with:
      python_version: '3.11'
      test_file: 'tests/test_data_quality.py'
  show_results:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - name: show results
        run: |
          echo "test sttatus is: ${{needs.test.outputs.test_status}}"
          echo "number of rows is: ${{needs.test.outputs.row_count}}"

